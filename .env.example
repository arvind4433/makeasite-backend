PORT=5000
NODE_ENV=production
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRE=30d
FRONTEND_URL=https://www.makeasite.online
ALLOWED_ORIGINS=https://www.makeasite.online,https://makeasite.online

MONGODB_URI=your_mongodb_connection_string

# Razorpay credentials (optional):
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Google OAuth credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://www.makeasite.online/api/auth/google/callback

# Facebook OAuth credentials
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=https://www.makeasite.online/api/auth/facebook/callback

# LinkedIn OAuth credentials
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_CALLBACK_URL=https://www.makeasite.online/api/auth/linkedin/callback

# Brevo (Sendinblue) Email OTP Service
BREVO_API_KEY=your_brevo_v3_api_key
BREVO_SENDER_EMAIL=contact@makeasite.online
BREVO_SENDER_NAME=MakeASite

# Twilio SMS OTP Service
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid
# Optional Twilio direct sender phone:
# TWILIO_PHONE_NUMBER=+1234567890
